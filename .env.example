NODE_ENV=development
PORT=3000
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Preferred locally: absolute path to a private service-account JSON file, outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternatively use Application Default Credentials. For local emulator only:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenWA Easy API service address. Keep this private (for example, an ECS-internal URL).
OPENWA_API_URL=http://localhost:8080
# A long random API key set on the OpenWA container as WA_API_KEY.
OPENWA_API_KEY=
# A separate long random shared secret sent by the OpenWA webhook plugin.
OPENWA_WEBHOOK_SECRET=
# Optional E.164 number used for OpenWA QC alerts, for example +919876543210.
OPERATOR_ALERT_WHATSAPP=
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
JWT_SECRET=
# Set only for a trusted reverse proxy, e.g. 1
TRUST_PROXY_HOPS=0
WORKER_POLL_MS=2000
